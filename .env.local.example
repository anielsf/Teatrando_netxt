# =============================================
# Variables de Entorno — Teatrando Next.js
# =============================================
# Copia este archivo como .env.local y rellena los valores
# NUNCA subas .env.local al repositorio

# ─── Supabase (Públicas - prefijo NEXT_PUBLIC_) ───────────────
NEXT_PUBLIC_SUPABASE_URL=https://muqhnbmaqprokczltdrj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# ─── Supabase (Privadas - solo servidor, nunca al cliente) ────
# Obtener en: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# ─── Base de datos directa (para pg Pool) ────────────────────
# Obtener en: Supabase Dashboard → Settings → Database → Connection string (URI)
POSTGRES_URL=postgresql://postgres:[TU_PASSWORD]@db.[TU_PROJECT_REF].supabase.co:5432/postgres

# ─── Upstash Redis (Rate Limiting) ───────────────────────────
# Crear base gratis en: https://upstash.com → Redis → Create Database
UPSTASH_REDIS_REST_URL=TU_UPSTASH_URL_AQUI
UPSTASH_REDIS_REST_TOKEN=TU_UPSTASH_TOKEN_AQUI

# ─── URL de la aplicación ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En producción: NEXT_PUBLIC_APP_URL=https://teatrando.vercel.app
